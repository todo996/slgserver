# ============================================================
# BIẾN DÙNG CHUNG
# ============================================================
# Railway là backend chạy lâu dài: dùng Session Pooler của Supabase, cổng 5432.
# Sao chép nguyên chuỗi tại Supabase Dashboard > Connect > Session pooler.
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@[REGION].pooler.supabase.com:5432/postgres?sslmode=require
DB_MAX_IDLE_CONNS=2
DB_MAX_OPEN_CONNS=10
XORM_SHOW_SQL=false
XORM_LOG_LEVEL=1
TZ=Asia/Bangkok

# Domain WSS public của gate-service. Login Server trả địa chỉ này cho client.
GATE_PUBLIC_URL=wss://gate-service-production.up.railway.app

# ============================================================
# HTTP SERVICE
# ============================================================
SERVICE_NAME=http
PORT=8088
# Thay bằng domain Vercel thật. Có thể nhập nhiều origin, phân cách bằng dấu phẩy.
CORS_ALLOWED_ORIGINS=https://ten-game.vercel.app

# ============================================================
# GATE SERVICE
# ============================================================
SERVICE_NAME=gate
PORT=8004
GATE_NEED_SECRET=true
SLG_PROXY_URL=ws://slg-service.railway.internal:8001
CHAT_PROXY_URL=ws://chat-service.railway.internal:8002
LOGIN_PROXY_URL=ws://login-service.railway.internal:8003

# ============================================================
# LOGIN SERVICE
# ============================================================
SERVICE_NAME=login
PORT=8003
LOGIN_NEED_SECRET=false

# ============================================================
# CHAT SERVICE
# ============================================================
SERVICE_NAME=chat
PORT=8002
CHAT_NEED_SECRET=false

# ============================================================
# SLG SERVICE
# ============================================================
SERVICE_NAME=slg
PORT=8001
SLG_NEED_SECRET=false
SLG_IS_DEV=false

# Lưu ý:
# - Mỗi Railway Service chỉ đặt đúng SERVICE_NAME và PORT của chính nó.
# - DATABASE_URL là bí mật; đặt trong Railway Variables, không commit giá trị thật.
# - Client chỉ truy cập gate-service bằng WSS và http-service bằng HTTPS.
# - Đăng ký tài khoản chỉ nhận POST; mật khẩu lưu trong PostgreSQL bằng bcrypt.
