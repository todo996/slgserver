# Một Railway Service duy nhất chạy đủ HTTP, Gate, Login, Chat và SLG.
# Railway tự cấp PORT public; không đặt PORT thủ công nếu không cần.

DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@[REGION].pooler.supabase.com:5432/postgres?sslmode=require
DB_MAX_IDLE_CONNS=2
DB_MAX_OPEN_CONNS=10
XORM_SHOW_SQL=false
XORM_LOG_LEVEL=1
TZ=Asia/Bangkok

# Domain public duy nhất của Railway.
# Có thể bỏ trống GATE_PUBLIC_URL nếu Railway cung cấp RAILWAY_PUBLIC_DOMAIN.
GATE_PUBLIC_URL=wss://tam-quoc-server-production.up.railway.app

# Domain Vercel/PWA được phép gọi HTTP API và mở WebSocket.
# Có thể nhập nhiều origin, phân cách bằng dấu phẩy.
CORS_ALLOWED_ORIGINS=https://ten-game.vercel.app
WS_ALLOWED_ORIGINS=https://ten-game.vercel.app

# Cấu hình game.
GATE_NEED_SECRET=true
LOGIN_NEED_SECRET=false
CHAT_NEED_SECRET=false
SLG_NEED_SECRET=false
SLG_IS_DEV=false
GAME_SERVER_ID=1

# Giới hạn thời gian chờ năm thành phần nội bộ khởi động.
STARTUP_TIMEOUT=180s

# Tuỳ chọn nâng cao.
# LOG_DIR=/app/log
# MAP_DATA_PATH=/app/data/map/map.json
# JSON_DATA_PATH=/app/data/conf/json
# DB_CONN_MAX_LIFETIME=30m
