FROM golang:1.22-alpine AS builder

RUN apk add --no-cache ca-certificates git tzdata
WORKDIR /src

COPY . .
RUN go mod tidy \
    && CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/allserver ./main/allserver.go \
    && CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/gateserver ./main/gateserver.go \
    && CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/httpserver ./main/httpserver.go \
    && CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/loginserver ./main/loginserver.go \
    && CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/chatserver ./main/chatserver.go \
    && CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/slgserver ./main/slgserver.go

FROM alpine:3.20

RUN apk add --no-cache ca-certificates tzdata
WORKDIR /app

COPY --from=builder /out/ /app/
COPY --from=builder /src/data/ /app/data/
COPY deploy/railway-entrypoint.sh /app/railway-entrypoint.sh

RUN chmod +x /app/railway-entrypoint.sh

ENV TZ=Asia/Bangkok
ENV STARTUP_TIMEOUT=180s

EXPOSE 8080
ENTRYPOINT ["/app/railway-entrypoint.sh"]
